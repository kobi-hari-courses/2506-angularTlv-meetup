# Apply to every project, including nested projects.

# Node.js dependencies and package manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Angular and compiled output
dist/
build/
out-tsc/
bazel-out/
tmp/
**/.angular/cache/
.sass-cache/
*.tsbuildinfo

# Test output
coverage/
.nyc_output/
testem.log

# Logs and runtime files
logs/
*.log
*.pid
*.pid.lock
report.*.json

# Local environment files (keep templates versioned)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Editors (keep shared VS Code configuration versioned)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
